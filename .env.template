# ============================================================
# NBA Prop AI - Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your real keys.
# Lines starting with # are comments and are ignored.
#
# REQUIRED for live data:
#   - BALLDONTLIE_API_KEY or BDL_API_KEY  (stats, injuries, games, pace)
#
# Odds (merged on every scan):
#   - Kalshi + Polymarket                 (public, NO KEY, on by default)
#   - THE_ODDS_API_KEY or ODDS_API_KEY    (optional, adds sportsbooks)
#
# Not used by the daily scan:
#   - SPORTSDATAIO_API_KEY
#
# RETIRED (no longer used in the engine):
#   - nba_api / NBA.com stats endpoints
#   - SPORTRADAR_API_KEY
#   - FANTASYPROS_API_KEY, NBA_OFFICIAL_API_KEY
#   - STATMUSE_API_KEY, ROTOGRINDERS_API_KEY, ROTOWIRE_API_KEY
# ============================================================

# ------------------------------------------------------------
# SportsDataIO  (optional, not used by the daily scan)
# Get your key at: https://sportsdata.io/
# ------------------------------------------------------------
SPORTSDATAIO_API_KEY=

# ------------------------------------------------------------
# SPORTSBOOK ODDS  (The Odds API — optional, merged with Kalshi/Polymarket)
# SOURCE: prop lines, over/under prices, line shopping
# Get your key at: https://the-odds-api.com/
# ------------------------------------------------------------
THE_ODDS_API_KEY=

# ------------------------------------------------------------
# PREDICTION MARKETS  (Kalshi + Polymarket — public, no key)
# Every NBA player prop + moneyline/spread/total for the date.
# ------------------------------------------------------------
# KALSHI_ENABLED=true
# POLYMARKET_ENABLED=true
# PREDICTION_MARKET_TIMEOUT=20
# PREDICTION_MARKET_MAX_SPREAD=0.15
# PREDICTION_MARKET_MIN_PRICE=0.02
# PREDICTION_MARKET_MAX_PRICE=0.98
# KALSHI_FEE_RATE=0.07

# ------------------------------------------------------------
# BALLDONTLIE GOAT  (replaces nba_api / NBA.com)
# Docs: https://docs.balldontlie.io/
# Trial: 5 requests/minute. Paid GOAT: set BDL_REQUESTS_PER_MINUTE=600
# ------------------------------------------------------------
BALLDONTLIE_API_KEY=
# BDL_API_KEY=
# NBA_SEASON=2026-27
# BDL_REQUESTS_PER_MINUTE=5
# BDL_TIMEOUT=30
# BDL_MAX_RETRIES=4

# ------------------------------------------------------------
# OPENAI (optional — only `python main.py advisor` / AI Advisor tab)
# ------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=medium   # low | medium | high | xhigh | max
# OPENAI_TIMEOUT=120
# OPENAI_MAX_OUTPUT_TOKENS=8000

# ------------------------------------------------------------
# CSV IMPORT (optional — overrides any source per file)
# ------------------------------------------------------------
# CSV_PLAYERS_PATH=data/import/players.csv
# CSV_ODDS_PATH=data/import/odds.csv
# CSV_DEFENSE_PATH=data/import/defense.csv

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------
# LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
# LOG_TO_FILE=false
# LOG_FILE=nba_prop_ai.log
# CACHE_TTL=300           # in-memory cache TTL in seconds (0 = disable)
# DISK_CACHE_ENABLED=true # set to false to disable disk caching
