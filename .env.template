# NBA Prop AI — local configuration
#
# `live` uses exactly one external sports-data provider: BALLDONTLIE.
# `demo` and `replay` use local data only and make no external provider calls.

APP_MODE=demo

# Required only in APP_MODE=live. Keep this value out of source control.
BALLDONTLIE_API_KEY=
BALLDONTLIE_BASE_URL=https://api.balldontlie.io
BALLDONTLIE_TIMEOUT=20
BALLDONTLIE_MAX_RETRIES=3
BALLDONTLIE_REQUEST_BUDGET_PER_MINUTE=60
BALLDONTLIE_ODDS_REFRESH_SECONDS=60
BALLDONTLIE_STABLE_CACHE_SECONDS=86400

# Reject price observations older than this retrieval-age threshold. A missing
# provider source timestamp is flagged separately and is never fabricated.
MAX_QUOTE_AGE_SECONDS=120

# Application
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=nba_prop_ai.log
CACHE_TTL=300
DISK_CACHE_ENABLED=true
EVALUATION_DB_PATH=data/evaluation/forecast_ledger.sqlite3
