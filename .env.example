# Copy to .env and fill in the two keys. .env is gitignored.
# Live scans use only these providers.

THE_ODDS_API_KEY=
BALLDONTLIE_API_KEY=

# Optional aliases
# ODDS_API_KEY=
# BDL_API_KEY=

# Trial BALLDONTLIE tier is 5 requests/minute. Paid GOAT is 600.
# BDL_REQUESTS_PER_MINUTE=5

# AI Advisor (python main.py advisor). Optional; Kalshi / Polymarket odds need no key.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=medium
